{
  "name": "magnetgate-app",
  "productName": "magnetgate",
  "version": "0.3.4",
  "description": "Desktop UI for the magnetgate censorship-resistant tunnel client",
  "author": "magnetgate",
  "private": true,
  "main": "main.js",
  "scripts": {
    "prestart": "node prepare-seed.js && node ../scripts/build-peer.cjs",
    "start": "electron .",
    "predist": "node prepare-seed.js && node ../scripts/build-peer.cjs",
    "dist": "electron-builder --win portable zip",
    "install:electron": "node node_modules/electron/install.js",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/renderer-browser.cjs",
    "predist:mac": "node prepare-seed.js && node ../scripts/build-peer.cjs",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:win": "npm run dist"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.magnetgate.app",
    "productName": "magnetgate",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "*.cjs"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "src"
      },
      {
        "from": "../node_modules",
        "to": "node_modules"
      },
      {
        "from": "../tools/sing-box",
        "to": "tools/sing-box",
        "filter": [
          "sing-box.exe",
          "sing-box",
          "wintun.dll",
          "refilter-domains.srs",
          "refilter-ip.srs",
          "tunnel-userlist.srs"
        ]
      },
      {
        "from": "../magnetgate.config.example.json",
        "to": "magnetgate.config.example.json"
      },
      {
        "from": "seed-config.json",
        "to": "seed-config.json"
      },
      {
        "from": "src-package.json",
        "to": "src/package.json"
      },
      {
        "from": "../scripts/kill-switch.ps1",
        "to": "scripts/kill-switch.ps1"
      },
      {
        "from": "../scripts/pins.json",
        "to": "scripts/pins.json"
      },
      {
        "from": "../tools/peer",
        "to": "tools/peer"
      }
    ],
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "portable": {
      "unpackDirName": true,
      "artifactName": "magnetgate-${version}.exe"
    },
    "beforePack": "./verify-resources.cjs",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "identity": null,
      "artifactName": "magnetgate-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "magnetgate-${version}-mac-${arch}.${ext}"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
