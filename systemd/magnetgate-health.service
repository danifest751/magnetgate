[Unit]
Description=magnetgate exit publication health check
After=magnetgate-exit.service

[Service]
Type=oneshot
User=magnetgate
Group=magnetgate
EnvironmentFile=/etc/magnetgate.env
ExecStart=/usr/bin/node /opt/magnetgate/scripts/healthcheck.mjs

# --- sandboxing / least privilege (read-only check) ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
