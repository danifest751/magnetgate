<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Not for a receiver: a persisted job is one the system keeps across a reboot, and it asks for this
       permission to prove the app is allowed to be woken after one. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- To offer the update this application fetched and verified itself. The system still asks the
       person, and still refuses a package signed with a different key than the installed one. -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

  <application
    android:name=".MagnetGateApp"
    android:label="@string/app_name"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:theme="@android:style/Theme.Material.Light.NoActionBar"
    android:allowBackup="false"
    android:supportsRtl="true">

    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:label="@string/app_name">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- The tunnel. It owns the core and the engine while it runs, and only Android may start it. -->
    <service
      android:name=".MgVpnService"
      android:exported="false"
      android:permission="android.permission.BIND_VPN_SERVICE"
      android:foregroundServiceType="specialUse">
      <intent-filter>
        <action android:name="android.net.VpnService" />
      </intent-filter>
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="vpn" />
    </service>

    <!-- The watchdog. It is held by the system rather than by this process, which is the whole point:
         it is what is left when the process carrying the tunnel dies. -->
    <service
      android:name=".WatchdogJob"
      android:exported="false"
      android:permission="android.permission.BIND_JOB_SERVICE" />
  </application>

</manifest>
